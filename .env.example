# Copy to .env.local and replace placeholders. Never commit real values.
# For the explicitly labeled test adapter, leave LLM_API_KEY unset.
LLM_API_KEY=REPLACE_WITH_SERVER_SIDE_API_KEY
LLM_BASE_URL=https://YOUR_PROVIDER_HOST/v1
LLM_MODEL=REPLACE_WITH_AVAILABLE_MODEL_ID
# Optional request timeout in milliseconds:
LLM_TIMEOUT_MS=14000

